# =============================================================================
# Configuration FNCCR V2 — copier en `.env` et remplir. JAMAIS commité.
# Sur le VPS : chmod 600. Voir docs_architecture/05_DEPLOIEMENT.md.
# =============================================================================

# --- Application ---
# production => exige SECRET_KEY, cookies Secure, HSTS
ENVIRONMENT=development
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOUVELLE clé pour la V2 (ne pas réutiliser celle de la v1)
SECRET_KEY=
# URL publique — sert à construire les liens des emails (jamais le header Host)
APP_PUBLIC_URL=http://localhost:8000

# --- Grist (source de données unique) ---
GRIST_API_KEY=
GRIST_DOC_ID=
GRIST_SERVER_URL=https://grist.francedatareseau.fr

# --- SSO OIDC : connexion principale ---
# Le SSO s'active automatiquement quand les 3 variables sont renseignées.
# OIDC_CLIENT_SECRET est requis pour un client confidentiel, optionnel
# pour un client public avec PKCE.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Exemple local Keycloak (dev) ---
# APP_PUBLIC_URL=http://keycloak.localhost:8001
# OIDC_ISSUER=http://localhost:8080/realms/fdr
# OIDC_CLIENT_ID=tcd
# OIDC_CLIENT_SECRET=
