# ============================================================
#  Modèle de configuration — app Formulaire FNCCR (tcd.francedatareseau.fr)
#  Copier ce fichier en `.env` et renseigner les valeurs réelles.
#  ⚠️ NE JAMAIS committer le .env rempli (il contient des secrets).
# ============================================================

# --- Grist (backend de données — OBLIGATOIRE) ---
# Réutiliser les mêmes valeurs que l'instance actuelle (même document Grist),
# OU de nouvelles valeurs si l'on pointe vers un autre document.
GRIST_API_KEY=<clé API Grist — Profile Settings → API Key>
GRIST_DOC_ID=<ID du document Grist — visible dans l'URL /docs/<DOC_ID>/...>

# --- Sécurité session (OBLIGATOIRE en prod) ---
# Générer une valeur FIXE et la garder stable :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (une clé non fixe = toutes les sessions invalidées à chaque redémarrage)
SECRET_KEY=<32+ caractères aléatoires>

# Active les cookies Secure + HSTS (impératif derrière HTTPS)
ENVIRONMENT=production

# --- TLS / Caddy (OBLIGATOIRE si on utilise le Caddy fourni) ---
# Email pour Let's Encrypt (notifications d'expiration de certificat).
LE_EMAIL=<email-admin@francedatareseau.fr>

# --- Lien public affiché dans les emails (OPTIONNEL) ---
APP_PUBLIC_URL=https://tcd.francedatareseau.fr

# ============================================================
#  Notification email des nouvelles inscriptions (OPTIONNEL — DORMANT)
#  Tant que ces variables ne sont pas toutes renseignées, l'app n'envoie
#  aucun email (l'inscription fonctionne quand même). Pour activer, remplir :
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<compte expéditeur>
# SMTP_PASSWORD=<mot de passe d'application / secret SMTP>
# SMTP_FROM=<adresse expéditeur — défaut = SMTP_USER>
# ADMIN_NOTIFY_EMAILS=<destinataire1@ex.fr,destinataire2@ex.fr>
