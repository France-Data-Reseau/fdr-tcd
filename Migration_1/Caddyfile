# Caddy — reverse proxy + TLS automatique (Let's Encrypt) pour l'app FNCCR.
# Domaine : tcd.francedatareseau.fr

{
    email {$LE_EMAIL}
}

tcd.francedatareseau.fr {
    encode gzip

    # En-têtes de sécurité (équivalents à ceux du VPS revorun.eu)
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy tcd:8000
}
